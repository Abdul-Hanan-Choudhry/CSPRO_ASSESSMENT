# Copy to .env to override defaults. All values below are synthetic/demo values.

# Vector store: embedded on-disk mode by default. Set QDRANT_URL to use a Qdrant server instead.
QDRANT_PATH=.qdrant
# QDRANT_URL=http://localhost:6333
COLLECTION_ALIAS=kb_live

# Fusion method: rrf (production) | legacy_naive (reproduces the incident's score-scale bug)
FUSION=rrf

# LLM runtime: ollama | fake (deterministic, for offline demos/tests)
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_S=180

EMBED_CACHE_DIR=.cache/fastembed

# Synthetic demo keys. Replace in any real deployment.
# API_KEYS={"demo-c1001":{"customer_id":"C-1001","role":"customer"},"demo-c1002":{"customer_id":"C-1002","role":"customer"},"demo-admin":{"customer_id":null,"role":"admin"}}

LOG_LEVEL=INFO
